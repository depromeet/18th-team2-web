# 로컬 개발 시 .env로 복사해서 사용
# cp .env.example .env
#
# 환경별 기본값은 .env.development / .env.production에 정의됨
# .env 파일이 있으면 환경별 파일보다 우선 적용됨

# Application
VITE_APP_ENV=development

# API
VITE_API_BASE_URL=https://dev-api.hapalin.com

# Kakao JavaScript SDK
VITE_KAKAO_JAVASCRIPT_KEY=

# Sentry DSN
VITE_SENTRY_DSN=

# GA
VITE_GA_MEASUREMENT_ID=
